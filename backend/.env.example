# StageTTS 主后端环境变量示例（复制为 backend/.env 后按本机路径修改）

# 目录配置（留空则默认使用仓库根目录下的 workspace/ 与 assets/）
WORKSPACE_DIR=
ASSETS_DIR=

# GPT-SoVITS 根目录与轻量 v2 CUDA 配置文件（启用按需启停时必填）
GPT_SOVITS_ROOT=C:/Project/GPT-SoVITS-v5-20261006nvidia50x0
GPT_SOVITS_CONFIG=backend/tts_v2.yaml
# 显存串行接力开关：1 = 轮到合成时自动拉起 GPT-SoVITS，轮到解析前自动关闭释放 100% 显存
TTS_AUTO_MANAGE=1
TTS_STARTUP_TIMEOUT_SEC=90

# Pinned primary parser: MOSS-Transcribe-Diarize + Banquet.
# See docs/moss_setup.md for the isolated Python 3.12 CUDA environment, official local model snapshot,
# custom-code hash approval and the 90-minute input budget (hardware measurements only cover 60s).
ENV_PARSE_PYTHON=F:/Download/StageTTS/env_moss/python.exe
PARSE_BACKEND=moss
MOSS_MODEL_PATH=F:/Download/StageTTS/diarization_models/moss-transcribe-diarize
MOSS_REVISION=10304d926740cf5a5cee05a268086e3265197910
MOSS_TORCH_VERSION=2.8.0+cu128
MOSS_TRANSFORMERS_VERSION=5.6.0
MOSS_CUSTOM_CODE_APPROVED=0
MOSS_MAX_AUDIO_SECONDS=5400
MOSS_MAX_NEW_TOKENS=65536

# Required only for Banquet four-stem separation (install compatible Bandit sources locally).
BANQUET_ROOT=
BANQUET_CHECKPOINT=
HF_HOME=F:/Download/StageTTS/hf_cache
HUGGINGFACE_HUB_CACHE=F:/Download/StageTTS/hf_cache/hub
TORCH_HOME=F:/Download/StageTTS/torch_cache
PIP_CACHE_DIR=F:/Download/StageTTS/pip_cache

# GPT-SoVITS api_v2.py 推理服务地址
TTS_API_URL=http://127.0.0.1:9880
# 手动启动的 GPT-SoVITS 若使用其他初始权重，请指定路径供角色切换后恢复。
TTS_DEFAULT_GPT_WEIGHTS=
TTS_DEFAULT_SOVITS_WEIGHTS=

# 超时控制（秒）
TTS_TIMEOUT_SEC=120
PARSE_TIMEOUT_SEC=1800
LLM_TIMEOUT_SEC=60

# LLM config (UI settings take precedence)
LLM_API_KEY=local-gateway-no-key
LLM_BASE_URL=http://127.0.0.1:3425/v1
LLM_MODEL=workbuddy-ai/hy4flash-free

# Optional Hugging Face token for other authorized workflows. MOSS does not require this token.
HF_TOKEN=

# 可选 M3 源声分析：只使用已获授权的本地模型，留空时不运行 SER、不联网下载。
# 建议独立环境；不要升级现有 parse/TTS 环境来满足分析依赖。
ENV_ANALYSIS_PYTHON=
EMOTION_MODEL_PATH=
EMOTION_MODEL_ID=
# 模型revision与候选FunASR精确版本必须显式固定，以下不代表已安装/验证。
EMOTION_REVISION=
EMOTION_FUNASR_VERSION=
# 仅在模型许可和本地权重使用已获授权时设置；默认不运行情绪模型。
EMOTION_USER_AUTHORIZED=0
# 默认使用已验证可用的CUDA设备；可显式改cpu，但不会静默CPU重推理。
EMOTION_DEVICE=cuda:0
# 可选pYIN有声F0分析，缺依赖/无有声帧时返回not_available。
ANALYSIS_ENABLE_F0=1

# 新主解析依赖：MOSS joint ASR+角色+句段时间；未配置则明确失败，不静默回退。
# ENV_PARSE_PYTHON需指向准备完成的新env_moss；旧环境保留，回滚显式PARSE_BACKEND=legacy。
PARSE_BACKEND=moss
MOSS_MODEL_PATH=
MOSS_REVISION=10304d926740cf5a5cee05a268086e3265197910
MOSS_TORCH_VERSION=2.8.0+cu128
MOSS_TRANSFORMERS_VERSION=5.6.0
# 仅对已审核、固定hash的官方本地custom code授权，不允许任意远程更新。
MOSS_CUSTOM_CODE_APPROVED=0
# 默认允许最长90分钟；8GB实测仅覆盖60秒，长音频显存/耗时需验证，不自动切窗伪同人。
MOSS_MAX_AUDIO_SECONDS=5400
MOSS_MAX_NEW_TOKENS=65536
